NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_ID=

# Server-side only — used by lib/supabase/admin-client.ts for admin-privileged
# operations (user create/delete/password-reset, SWITCH edu-ID provisioning).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# SWITCH edu-ID OIDC (see lib/oidc/client.ts, app/api/auth/switch/*).
# Local dev: point these at the mock provider (`npm run mock-oidc`), e.g.
#   SWITCH_OIDC_ISSUER_URL=http://localhost:9999
#   SWITCH_OIDC_CLIENT_ID=time-use-tool-dev
#   SWITCH_OIDC_CLIENT_SECRET=dev-secret
#   SWITCH_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/switch/callback
# Production: replace with the values from the SWITCH SP registration — no
# code changes needed, only these four values.
SWITCH_OIDC_ISSUER_URL=
SWITCH_OIDC_CLIENT_ID=
SWITCH_OIDC_CLIENT_SECRET=
SWITCH_OIDC_REDIRECT_URI=
